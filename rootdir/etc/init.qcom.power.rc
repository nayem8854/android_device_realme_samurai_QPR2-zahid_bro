# RealmeParts Persistent Performance Profiles.
# The kernel exposes only schedutil up_rate_limit_us and down_rate_limit_us.
# Power HAL must not write these persistent profile nodes..
#----------------------------------------------------------------#
#####   BALANCE-MODE ON  #####
#---------------------------------------------------------------#
on property:perf_profile=0
#----------------------------------------------------------->>>
    # SCHEDULER MIGRATION THRESHOLDS: CONSERVATIVE CLUSTER PROMOTION/DEMOTION.
    write /proc/sys/kernel/sched_upmigrate "95 95"
    write /proc/sys/kernel/sched_downmigrate "85 85"

    # NEUTRAL SCHEDUTIL PROFILE.
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/down_rate_limit_us 5000
    
    # DISPLAY COMPOSITION POLICY.
    setprop vendor.display.enable_rotator_ui 0

    # FOREGROUND SCHEDULING POLICY.

#------------------------------------------------------------#
#####   GAME-MODE ON   #####
#-----------------------------------------------------------#
on property:perf_profile=1
#-------------------------------------------------------->>>
    # EARLIER PROMOTION AND LONGER RESIDENCY ON PERFORMANCE CLUSTERS.
    write /proc/sys/kernel/sched_upmigrate "96 90"
    write /proc/sys/kernel/sched_downmigrate "75 80"

    # AGGRESSIVE BUT BOUNDED SCHEDUTIL PROFILE.
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/down_rate_limit_us 15000
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/down_rate_limit_us 10000
    
    # DISPLAY COMPOSITION POLICY.
    setprop vendor.display.enable_rotator_ui 1

    # FOREGROUND SCHEDULING POLICY. POWER HAL RETAINS OWNERSHIP OF TEMPORARY
    # TOP-APP BOOSTS USED BY INTERACTION AND LAUNCH HINTS.
