cc_binary {
    name: "android.hardware.health-service.samurai",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.health-service.samurai.rc"],
    vintf_fragments: ["android.hardware.health-service.samurai.xml"],
    srcs: [
        "HealthService.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.health-V4-ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "libhealth_aidl_impl",
        "libhealthloop",
        "libbatterymonitor",
    ],
    overrides: [
        "android.hardware.health-service.example",
        "vendor.lineage.health-service.default",
    ],
}
